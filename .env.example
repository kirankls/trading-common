# All optional -- every trading_common data client degrades gracefully
# (empty dict/Result.failure) when its key is absent, never raises.

SCHWAB_TRADING_APP_KEY=
SCHWAB_TRADING_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=secrets/schwab_token.enc.json

POLYGON_API_KEY=
FINNHUB_API_KEY=
TRADIER_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=

ENCRYPTION_MASTER_KEY=

# Alerting (services/alerts.py) -- leave unset to no-op that channel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=sqlite+aiosqlite:///./data/trading_common.db
ASYNC_DATABASE_URL=

APP_ENV=development
LOG_LEVEL=INFO
